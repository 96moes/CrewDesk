{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run seo:check && npm run seo:files && npm run seo:prerender",
    "build:prod": "tsc -b && vite build && npm run seo:check && node scripts/generate-seo-files.mjs --production && node scripts/prerender.mjs --fail-on-error",
    "build:spa": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seo:check": "node scripts/check-seo.mjs",
    "seo:files": "node scripts/generate-seo-files.mjs",
    "seo:prerender": "node scripts/prerender.mjs",
    "seo:verify": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "antd": "^6.6.2",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router": "^8.3.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "puppeteer-core": "^25.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
