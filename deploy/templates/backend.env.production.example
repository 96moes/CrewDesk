# CrewDesk backend — production environment
# Install on the server as /opt/crewdesk/backend/.env  (chmod 600, owned by the service user)
#
# Never commit a real .env. This file is a template only.

# --- HTTP ---
# Bind port for the API. Keep it private: nginx (127.0.0.1) proxies to it.
PORT=3000

# CORS allowed origin(s).
# Same-origin setup (frontend and API under one domain, as in DEPLOYMENT.md):
#   FRONTEND_URL=https://crewdesk.example.com
# Split setup (frontend on www, API on api subdomain) — comma-separated, no spaces:
#   FRONTEND_URL=https://crewdesk.example.com,https://www.crewdesk.example.com
# Use the exact scheme + host, no trailing slash. A wrong value here is the #1 cause
# of browser "CORS policy" / blocked-request errors.
FRONTEND_URL=https://crewdesk.example.com

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=crewdesk
DB_PASSWORD=replace_with_the_database_password
DB_DATABASE=crewdesk

# --- Auth ---
# Generate with: openssl rand -base64 48
# Changing this later logs every user out.
JWT_SECRET=replace_with_a_long_random_secret

# --- First-run administrator seed ---
# The seed runs on every startup but only creates the user when the username is absent.
# Set SEED_ADMIN=false after the first successful start so the password in this file
# is no longer a credential that matters.
SEED_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_password
# The role for the seeded account: ADMIN to manage the site including user accounts,
# MANAGER to manage everything else, or USER for an ordinary account. Keep ADMIN here —
# only an administrator can hand out the other roles afterwards.
ADMIN_ROLE=ADMIN
