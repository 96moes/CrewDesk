# CrewDesk frontend — production build-time environment
# Copy to frontend/.env.production ON THE BUILD MACHINE before running `npm run build`.
#
# Vite inlines VITE_* values into the JavaScript bundle at build time, so:
#   * changing any value requires a rebuild (editing it on the server does nothing)
#   * these values are public — never put secrets here

# Same-origin setup (recommended; nginx serves the API path on the same domain):
# leave this EMPTY so requests go to the current origin, e.g. /auth/login.
VITE_API_BASE_URL=

# Split setup (API on its own subdomain) — then set the full origin:
# VITE_API_BASE_URL=https://api.crewdesk.example.com

# --- SEO -------------------------------------------------------------------
# Public origin of the site. No trailing slash.
# This value builds every canonical URL, og:url, the sitemap entries and robots.txt.
# If it is wrong, you are telling Google to index a site you do not own, so verify it
# after each production build with:
#   grep -o '<link rel="canonical"[^>]*>' frontend/dist/index.html
VITE_SITE_URL=https://crewdesk.example.com

# Social preview image, 1200x630 PNG or JPG, in frontend/public/.
# Leave as-is unless you rename the file. index.html declares og:image:width/height
# as 1200x630, so a replacement should keep those dimensions or the card renders
# incorrectly on some platforms.
VITE_OG_IMAGE=/og-image.png

# --- Optional contact details ----------------------------------------------
# Shown on the registration page.
VITE_ADMIN_PHONE=replace_with_contact_phone
VITE_TELEGRAM_ADMIN=replace_with_telegram_username
