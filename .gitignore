# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Build output and test artifacts
dist/
build/
.next/
coverage/
.nyc_output/
*.tsbuildinfo

# Local environment configuration; keep safe templates
.env
.env.*
!.env.example
!**/.env.example

# Logs and diagnostic output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Local PostgreSQL data and database exports
pgdata/
postgres-data/
*.dump
*.sql
*.sql.gz
*.backup
*.bak

# Migration scripts are source, not exports, and have to reach the server with a deploy.
!deploy/scripts/*.sql

# Vite and temporary files
.vite/
*.local
.temp/
.tmp/
